{
  "name": "tracklens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vite --mode full",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs dist",
    "build:full": "tsc -b && vite build --mode full && node scripts/postbuild.mjs dist-full",
    "check:dist": "node scripts/check-dist.mjs dist",
    "preview": "vite preview",
    "preview:full": "vite preview --mode full --outDir dist-full",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@observablehq/plot": "^0.6.19",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
